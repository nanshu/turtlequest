{
  "name": "turtlequest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "dev": "node scripts/build-assets.mjs && wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply turtlequest-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply turtlequest-db --remote",
    "reset-pin": "node scripts/reset-pin.mjs",
    "deploy": "node scripts/build-assets.mjs && wrangler pages deploy",
    "test": "node tests/run-all.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.169.0"
  }
}
